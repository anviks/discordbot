# Copy to .env for local development. On a server this file is installed as
# /etc/max-bot/env and read by systemd's EnvironmentFile=.

# --- Secrets ---
DISCORD_BOT_TOKEN=

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_KEY=

# --- Discord ---
DEFAULT_GUILD_ID=
DEFAULT_CHANNEL_ID=

# --- Paths ---
# Relative paths are resolved against the project root
SQLITE_DB_PATH=db/app.sqlite
#LOGS_DIR=

# --- HTTP control API ---
# 0.0.0.0 so the web UI can be reached from other machines on the LAN.
#API_HOST=0.0.0.0
#API_PORT=8000
